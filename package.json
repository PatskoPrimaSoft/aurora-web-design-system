{
  "name": "@primasoftllc/design-system",
  "version": "5.1.1",
  "description": "Aurora — дизайн-система веб-интерфейса GPS-мониторинга: токены, компоненты, линтер",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PrimaSoftLLC/aurora-web-design-system.git"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "type": "module",
  "main": "dist/react/index.mjs",
  "files": [
    "dist/",
    "fonts/",
    "assets/fonts/",
    "components/src/",
    "lint/",
    "!lint/test/",
    "templates/angular/",
    "tokens.json",
    "CHANGELOG.md",
    "design-system/README.md",
    "design-system/docs/",
    "design-system/lint/README.md",
    "design-system/components/DsButton/README.md",
    "docs/usage.md",
    "ng-ui-kit/README.md",
    "ng-ui-kit/docs/development.md",
    "ng-ui-kit/docs/adding-components.md",
    "ng-ui-kit/src/components/button/README.md",
    "components/DsButton/README.md",
    "docs/design.md",
    "docs/tokens.md",
    "docs/migration.md",
    "docs/release.md",
    "CONTRIBUTING.md",
    "AGENTS.md"
  ],
  "exports": {
    "./angular": {
      "types": "./dist/angular/core.d.mts",
      "default": "./dist/angular/core.mjs"
    },
    "./angular/echarts": {
      "types": "./dist/angular/echarts.d.mts",
      "default": "./dist/angular/echarts.mjs"
    },
    ".": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.mjs",
      "default": "./dist/react/index.mjs"
    },
    "./styles.css": "./dist/styles.css",
    "./tokens.css": "./dist/tokens.css",
    "./tokens.json": "./tokens.json",
    "./stylelint-config": "./lint/config.js",
    "./echarts-theme": "./components/src/components/charts/echartsTheme.mjs",
    "./package.json": "./package.json"
  },
  "scripts": {
    "check:angular": "node ng-ui-kit/tools/check-angular.mjs",
    "test": "npm run test:lint && npm run test:ui",
    "test:lint": "node design-system/lint/test/run.js",
    "test:ui": "node design-system/tests/DsFilterMenu.test.js && node design-system/tests/a11y-tokens.test.js && node design-system/tests/checkbox.test.js && node design-system/tests/radio-progress.test.js && node design-system/tests/date-controls.test.js && node design-system/tests/switch.test.js && node design-system/tests/rows-buttons.test.js && node design-system/tests/nav-dialog-i18n.test.js && node design-system/tests/page-layout.test.js && node design-system/tests/field.test.js && node design-system/tests/select.test.js && node tests/guard-command.test.js && node tests/release-check.test.js && node tests/package.test.js && node design-system/tests/fonts.test.js && node tests/changelog-section.test.js && node design-system/tests/react-build.test.mjs && node tests/verification-plan.test.js",
    "check:names": "node design-system/lint/scripts/check-names.js",
    "check:delivery": "node design-system/lint/scripts/check-delivery.js",
    "build:allowlist": "node design-system/lint/scripts/build-allowlist.js",
    "build:scoped-tokens": "node design-system/lint/scripts/build-scoped-tokens.js",
    "build": "node tools/build.js",
    "check:parity": "node design-system/tools/check-parity.js",
    "check:pack": "node tools/check-pack.js",
    "prepack": "node tools/pack.mjs --reject-root",
    "verify": "node tools/verify.mjs",
    "pretest": "npm run build",
    "dev": "node design-system/tools/dev.mjs",
    "build:catalog": "node design-system/tools/catalog/build.mjs",
    "pack": "npm run build && node tools/pack.mjs"
  },
  "peerDependencies": {
    "@angular/common": "^19.2.25 || >=20.3.34",
    "@angular/core": "^19.2.25 || >=20.3.34",
    "echarts": "^6.1.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "stylelint": "^16.10.0 || ^17.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    },
    "echarts": {
      "optional": true
    },
    "@angular/core": {
      "optional": true
    },
    "@angular/common": {
      "optional": true
    },
    "stylelint": {
      "optional": true
    }
  },
  "devDependencies": {
    "@angular/common": "19.2.25",
    "@angular/compiler": "19.2.25",
    "@angular/compiler-cli": "19.2.25",
    "@angular/core": "19.2.25",
    "@angular/platform-browser": "19.2.25",
    "@angular/platform-browser-dynamic": "19.2.25",
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "echarts": "6.1.0",
    "esbuild": "0.28.2",
    "highlight.js": "11.12.0",
    "jsdom": "^24.1.3",
    "markdown-it": "15.0.2",
    "parse5": "8.0.1",
    "postcss": "^8.5.28",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "rxjs": "7.8.2",
    "stylelint": "^16.10.0",
    "typescript": "5.8.3",
    "zone.js": "0.15.1"
  },
  "engines": {
    "node": ">=20"
  },
  "types": "dist/react/index.d.ts"
}
