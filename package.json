{
  "name": "@primasoftllc/design-system",
  "version": "3.0.1",
  "description": "Aurora — дизайн-система веб-интерфейса GPS-мониторинга: токены, компоненты, линтер",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PrimaSoftLLC/aurora-web-design-system.git"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "type": "module",
  "main": "components/src/index.js",
  "files": [
    "dist/",
    "fonts/",
    "assets/fonts/",
    "components/src/",
    "lint/",
    "!lint/test/",
    "templates/angular/",
    "tokens.json",
    "CHANGELOG.md",
    "docs/usage.md",
    "docs/design.md",
    "docs/tokens.md",
    "docs/migration.md",
    "docs/release.md",
    "CONTRIBUTING.md",
    "AGENTS.md"
  ],
  "exports": {
    "./angular": {
      "types": "./dist/angular/core.d.mts",
      "default": "./dist/angular/core.mjs"
    },
    "./angular/echarts": {
      "types": "./dist/angular/echarts.d.mts",
      "default": "./dist/angular/echarts.mjs"
    },
    ".": "./components/src/index.js",
    "./styles.css": "./dist/styles.css",
    "./tokens.css": "./dist/tokens.css",
    "./tokens.json": "./tokens.json",
    "./stylelint-config": "./lint/config.js",
    "./echarts-theme": "./components/src/components/charts/echartsTheme.mjs",
    "./package.json": "./package.json"
  },
  "scripts": {
    "check:angular": "node tools/check-angular.mjs",
    "test": "npm run test:lint && npm run test:ui",
    "test:lint": "node lint/test/run.js",
    "test:ui": "node tests/DsFilterMenu.test.js && node tests/a11y-tokens.test.js && node tests/checkbox.test.js && node tests/rows-buttons.test.js && node tests/nav-dialog-i18n.test.js && node tests/page-layout.test.js && node tests/field.test.js && node tests/select.test.js && node tests/guard-command.test.js && node tests/package.test.js && node tests/fonts.test.js && node tests/changelog-section.test.js",
    "check:names": "node lint/scripts/check-names.js",
    "check:delivery": "node lint/scripts/check-delivery.js",
    "build:allowlist": "node lint/scripts/build-allowlist.js",
    "build:scoped-tokens": "node lint/scripts/build-scoped-tokens.js",
    "build": "node tools/build.js",
    "check:parity": "node tools/check-parity.js",
    "check:pack": "node tools/check-pack.js",
    "prepack": "npm run build",
    "verify": "node tools/verify.mjs",
    "pretest": "npm run build",
    "dev": "node tools/dev.mjs",
    "build:catalog": "node tools/catalog/build.mjs"
  },
  "peerDependencies": {
    "@angular/common": ">=19.0.0",
    "@angular/core": ">=19.0.0",
    "echarts": "^5.5.0 || ^6.0.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "stylelint": "^16.10.0 || ^17.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    },
    "echarts": {
      "optional": true
    },
    "@angular/core": {
      "optional": true
    },
    "@angular/common": {
      "optional": true
    },
    "stylelint": {
      "optional": true
    }
  },
  "devDependencies": {
    "@angular/common": "19.0.7",
    "@angular/compiler": "19.0.7",
    "@angular/compiler-cli": "19.0.7",
    "@angular/core": "19.0.7",
    "@angular/platform-browser": "19.0.7",
    "@angular/platform-browser-dynamic": "19.0.7",
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "echarts": "5.5.1",
    "esbuild": "0.28.2",
    "jsdom": "^24.1.3",
    "markdown-it": "15.0.2",
    "parse5": "8.0.1",
    "postcss": "^8.5.28",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "rxjs": "7.8.2",
    "stylelint": "^16.10.0",
    "typescript": "5.6.3",
    "zone.js": "0.15.1"
  },
  "engines": {
    "node": ">=20"
  }
}
